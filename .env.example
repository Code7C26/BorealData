# Variables que lee docker-compose.yml en el server. Copiar a `.env` (al lado del
# docker-compose.yml) y completar. El .env real nunca se commitea.

# --- Postgres (servicio `postgres` del compose) ---
POSTGRES_USER=aletheia
POSTGRES_PASSWORD=
POSTGRES_DB=aletheia

# Conexión que usa el backend. El host es el NOMBRE DEL SERVICIO del compose
# (`postgres`), no localhost: cada contenedor es su propia red local.
DATABASE_URL=postgres://aletheia:LA_MISMA_PASSWORD@postgres:5432/aletheia

# --- Firebase Admin (backend: verifica el ID token que manda el front) ---
# Id del proyecto de Firebase. Sin esto el backend responde 401
# "Token inválido o expirado" en /me, /history y /analyze.
# Normalmente es el mismo valor que NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# --- Gemini (backend) ---
GEMINI_API_KEY=
# Opcional: si se deja vacío se usa el default de readCapture.ts.
GEMINI_READ_MODEL=

# --- Firebase Web SDK (front) ---
# Están en consola de Firebase → Configuración del proyecto → Tus apps (Web).
# OJO: son build args, así que al cambiarlas hay que RECONSTRUIR la imagen del web,
# no alcanza con reiniciar el contenedor.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
