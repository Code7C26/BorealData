# Variables que lee docker-compose.yml. Copiar a `.env`, junto a docker-compose.yml,
# y completar. El .env real no se versiona.

# --- Postgres (servicio `postgres`) ---
POSTGRES_USER=aletheia
POSTGRES_PASSWORD=
POSTGRES_DB=aletheia

# Conexión del backend. El host es el nombre del servicio del compose (`postgres`),
# no localhost.
DATABASE_URL=postgres://aletheia:<password>@postgres:5432/aletheia

# Orígenes de la web que pueden llamar a la API, separados por coma y sin ruta.
CORS_ORIGIN=https://aletheiainc.online,https://www.aletheiainc.online

# --- Firebase Admin (backend) ---
# Id del proyecto de Firebase; normalmente igual a NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# Sin este valor, las rutas autenticadas responden 401.
FIREBASE_PROJECT_ID=

# --- Gemini (backend) ---
GEMINI_API_KEY=
# Opcional: modelo de lectura de imágenes. Vacío usa el default de readCapture.ts.
GEMINI_READ_MODEL=

# --- Web ---
# Se pasan como build args: al modificarlas hay que reconstruir la imagen web.
NEXT_PUBLIC_API_URL=https://aletheiainc.online/api
# Consola de Firebase → Configuración del proyecto → Tus apps (Web).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
