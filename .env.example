# Variables que lee docker-compose.yml. Copiar a `.env`, junto a docker-compose.yml,
# y completar. El .env real no se versiona.

# --- Postgres (servicio `postgres`) ---
POSTGRES_USER=aletheia
POSTGRES_PASSWORD=
POSTGRES_DB=aletheia

# Conexión del backend. El host es el nombre del servicio del compose (`postgres`),
# no localhost.
DATABASE_URL=postgres://aletheia:<password>@postgres:5432/aletheia

# Orígenes de la web que pueden llamar a la API, separados por coma y sin ruta.
CORS_ORIGIN=https://aletheiainc.online,https://www.aletheiainc.online

# --- Firebase Admin (backend) ---
# Id del proyecto de Firebase; normalmente igual a NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# Sin este valor, las rutas autenticadas responden 401.
FIREBASE_PROJECT_ID=

# --- Gemini (backend) ---
GEMINI_API_KEY=
# Opcional: modelo de lectura de imágenes. Vacío usa el default de readCapture.ts.
GEMINI_READ_MODEL=

# --- Recuperar contraseña y novedades por email (backend) ---
# Credenciales de administrador de Firebase, en base64 y en una sola línea. Sin esto,
# "me olvidé la contraseña" responde que no está disponible. La organización no deja
# crear claves de servicio, así que se usan las de un usuario de Google con acceso al
# proyecto, que deja `gcloud auth application-default login`. En PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("$env:APPDATA\gcloud\application_default_credentials.json"))
# (Una clave de servicio también sirve, si algún día se puede generar.)
FIREBASE_ADMIN_CREDENTIALS=
# SMTP para enviar los mails. Con Gmail: smtp.gmail.com, puerto 465 y una
# "contraseña de aplicación" (no la contraseña normal de la cuenta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opcional. Con Gmail tiene que ser la misma cuenta que SMTP_USER (o un alias suyo).
MAIL_FROM="AletheIA <tu-cuenta@gmail.com>"

# --- Web ---
# Se pasan como build args: al modificarlas hay que reconstruir la imagen web.
NEXT_PUBLIC_API_URL=https://aletheiainc.online/api
# Consola de Firebase → Configuración del proyecto → Tus apps (Web).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
