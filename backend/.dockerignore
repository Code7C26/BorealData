# Archivos excluidos del contexto de build de la imagen del backend.
#
# Excluir node_modules reduce el contexto y evita reemplazar las dependencias
# instaladas con `npm ci` por binarios del equipo local.

node_modules/
dist/

# Secretos: las variables se inyectan en tiempo de ejecución
.env
.env.*
!.env.example

# Desarrollo
*.log
*.md
.git/
.vscode/
coverage/

# Tests: no se corren adentro de la imagen
**/*.test.ts
