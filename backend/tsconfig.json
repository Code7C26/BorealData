{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  // Los tests viven al lado del código que prueban (src/**/*.test.ts) pero no se
  // compilan: `npm run build` produce lo que corre en producción, y los tests no van
  // ahí. Vitest los resuelve por su cuenta (ver vitest.config.mts), sin pasar por tsc.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
