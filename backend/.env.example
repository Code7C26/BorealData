# Copiá este archivo a .env y completá los valores. Nunca commitees el .env real.

# --- Servidor ---
PORT=4000
# Orígenes del front que pueden llamar a esta API, separados por coma.
# En desarrollo alcanza con el dev server de Next.js.
CORS_ORIGIN=http://localhost:3000

# --- Gemini ---
# API key de Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Modelo para el paso de LECTURA de imágenes (POST /analyze/read). Opcional:
# si no está, se usa el default de readCapture.ts.
GEMINI_READ_MODEL=

# --- Firebase Admin (verificación del ID token) ---
# Id del proyecto de Firebase. Las credenciales se resuelven con
# GOOGLE_APPLICATION_CREDENTIALS o con el service account de Cloud Run.
FIREBASE_PROJECT_ID=

# --- Base de datos ---
# Opción A (desarrollo local): string de conexión completa a Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aletheia
# Opción B (Cloud SQL): dejá DATABASE_URL vacía y completá estas tres.
# El connector resuelve la conexión sin exponer la IP de la instancia.
INSTANCE_CONNECTION_NAME=
DB_USER=
DB_PASSWORD=
DB_NAME=
