# Copiar a .env y completar. El .env real no se versiona.

# --- Servidor ---
PORT=4000
# Orígenes del front que pueden llamar a esta API, separados por coma.
# En desarrollo alcanza con el dev server de Next.js.
CORS_ORIGIN=http://localhost:3000

# --- Gemini ---
# API key de Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Modelo para el paso de LECTURA de imágenes (POST /analyze/read). Opcional:
# si no está, se usa el default de readCapture.ts.
GEMINI_READ_MODEL=

# --- Firebase Admin (verificación del ID token) ---
# Id del proyecto de Firebase. Las credenciales se resuelven con
# GOOGLE_APPLICATION_CREDENTIALS o con el service account de Cloud Run.
FIREBASE_PROJECT_ID=

# --- Recuperar contraseña y novedades por email (backend) ---
# Credenciales de administrador de Firebase, en base64 y en una sola línea. Sin esto,
# "me olvidé la contraseña" responde que no está disponible. La organización no deja
# crear claves de servicio, así que se usan las de un usuario de Google con acceso al
# proyecto, que deja `gcloud auth application-default login`. En PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("$env:APPDATA\gcloud\application_default_credentials.json"))
# (Una clave de servicio también sirve, si algún día se puede generar.)
FIREBASE_ADMIN_CREDENTIALS=
# SMTP para enviar los mails. Con Gmail: smtp.gmail.com, puerto 465 y una
# "contraseña de aplicación" (no la contraseña normal de la cuenta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opcional. Con Gmail tiene que ser la misma cuenta que SMTP_USER (o un alias suyo).
MAIL_FROM="AletheIA <tu-cuenta@gmail.com>"

# --- Base de datos ---
# Opción A (desarrollo local): string de conexión completa a Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aletheia
# Opción B (Cloud SQL): DATABASE_URL vacía y las variables siguientes completas.
# El connector resuelve la conexión sin exponer la IP de la instancia.
INSTANCE_CONNECTION_NAME=
DB_USER=
DB_PASSWORD=
DB_NAME=
