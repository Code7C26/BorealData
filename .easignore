# Archivos excluidos del paquete que se sube a EAS Build.
#
# Está en la raíz del repositorio porque EAS arma el paquete desde la raíz del repo
# git, no desde `mobile/`. Además de reducir el tamaño, impide que se suban los
# `.env` de los otros paquetes, que contienen credenciales.
#
# Sintaxis igual a la de `.gitignore`.

# ── Todo lo que no es la app móvil ───────────────────────────────────────────
/apps/
/backend/
/DOCS/
/design/
/assets/

# EAS no aplica las exclusiones de `node_modules` dentro de `mobile/` (comprobado con
# eas-cli 18 en varias variantes de patrón): `mobile/node_modules` representa la mayor
# parte de una subida de unos 800 MB. Para una subida liviana, mover la carpeta fuera
# del proyecto mientras dura la subida (con Metro detenido); EAS reinstala las
# dependencias desde el package-lock.json.
node_modules/

# ── Secretos, en cualquier carpeta ───────────────────────────────────────────
.env
.env.*
*.env
!.env.example

# ── Artefactos que EAS regenera ──────────────────────────────────────────────
/mobile/node_modules/
/mobile/.expo/
/mobile/dist/
/mobile/web-build/
/mobile/expo-env.d.ts
/mobile/ios/
/mobile/android/

# ── Herramientas de desarrollo ───────────────────────────────────────────────
/mobile/.vscode/
/mobile/.claude/
/mobile/scripts/
/.claude/
.git/
*.log
*.tsbuildinfo
*.jks
*.p8
*.p12
*.key
*.mobileprovision
