# Copiá este archivo a .env.local y completá los valores.
# Todo lo que empieza con NEXT_PUBLIC_ viaja al browser: acá no va ningún secreto.

# URL del backend (backend/src/index.ts). En desarrollo, el puerto de su .env.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Configuración del proyecto de Firebase (Consola > Configuración del proyecto >
# Tus apps > Configuración del SDK). La "apiKey" de Firebase es pública por
# diseño: identifica al proyecto, no autoriza nada por sí sola.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
