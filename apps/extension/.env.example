# Copiar a .env (desarrollo) y a .env.production (build para la Chrome Web Store)
# y completar. WXT expone al bundle solo las variables con prefijo WXT_.
#
# `npm run dev` lee .env; `npm run build` / `npm run zip` leen .env y encima
# .env.production. El manifest (host_permissions y los `matches` del content
# script) se arma con estos mismos valores, así que no hay que repetirlos en
# wxt.config.ts.

# Backend. En .env.production: https://aletheiainc.online/api
WXT_API_URL=http://localhost:4000

# Origen de la web, para el login, /resultado/:id y el puente de sesión
# (entrypoints/auth-bridge.content.ts). En .env.production: https://aletheiainc.online
WXT_WEB_ORIGIN=http://localhost:3000

# Misma apiKey pública de Firebase que usa la web (NEXT_PUBLIC_FIREBASE_API_KEY):
# el panel la necesita para refrescar el ID token que le pasa la web.
WXT_FIREBASE_API_KEY=
