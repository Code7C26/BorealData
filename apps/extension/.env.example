# Copiá este archivo a .env y completá los valores.
# WXT expone al bundle solo las variables con prefijo WXT_.

# Backend. TIENE que coincidir con la constante API_URL de wxt.config.ts: el
# manifest (host_permissions) se resuelve antes de que WXT cargue este archivo.
WXT_API_URL=http://localhost:4000

# Origen de la web, para abrir login y /resultado/:id desde el panel. También
# tiene que coincidir con los `matches` de entrypoints/auth-bridge.content.ts.
WXT_WEB_ORIGIN=http://localhost:3000

# Misma apiKey pública de Firebase que usa la web (NEXT_PUBLIC_FIREBASE_API_KEY):
# el panel la necesita para refrescar el ID token que le pasa la web.
WXT_FIREBASE_API_KEY=
