# Copiar a .env.local y completar. Los valores de Firebase son los mismos que los de
# apps/.env.local (mismo proyecto). Las variables EXPO_PUBLIC_* se incluyen en el
# bundle: no deben contener secretos.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# URL del backend desplegado. En desarrollo se deja vacía: la app la deduce del host
# de Metro (src/lib/config.ts).
# EXPO_PUBLIC_API_URL=

# Origen de la web desplegada, para los enlaces de compartir. Sin este valor, la app
# oculta el botón de compartir.
# EXPO_PUBLIC_WEB_ORIGIN=
