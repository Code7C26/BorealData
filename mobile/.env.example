# Copia este archivo a .env.local y completa los valores (los mismos que apps/.env.local:
# es el mismo proyecto de Firebase, asi que la cuenta de la web entra en la app).
# EXPO_PUBLIC_* viaja al bundle: aca no va ningun secreto.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Dejala vacia en desarrollo: la app deduce la IP de tu PC del host de Metro
# (src/lib/config.ts). Se completa cuando el backend este deployado.
# EXPO_PUBLIC_API_URL=
# EXPO_PUBLIC_WEB_ORIGIN=
